server {
    listen 80;
    server_name {{ httpd_domain_name }};
    return 301 https://$host$request_uri;
}

server {
    resolver {{ pve_vm_dns }}
    set $forward_scheme http;
    set $server         "{{ httpd_domain_IP }}";
    set $port           80;

    listen 443 ssl;
    server_name {{ httpd_domain_name }};

    ssl_certificate "/etc/pki/nginx/{{ httpd_domain_name }}.crt";
    ssl_certificate_key "/etc/pki/nginx/{{ httpd_domain_name }}.key";
    ssl_password_file "/etc/pki/nginx/{{ httpd_domain_name }}.passphrase.txt";

    location / {
        proxy_no_cache 1;
        proxy_cache_bypass 1;
        add_header       X-Served-By $host;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Scheme $scheme;
        proxy_set_header X-Forwarded-Proto  $scheme;
        proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP          $remote_addr;
        proxy_pass       $forward_scheme://$server:$port$request_uri;
    }
}
